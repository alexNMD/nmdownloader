{
  "name": "NMDownloader Dev",
  "dockerComposeFile": ["../compose-dev.yaml", "compose-devcontainer.yml"],
  "service": "discord",
  "workspaceFolder": "/NMDownloader",
  "remoteUser": "root",

  "customizations": {
    "jetbrains": {
      "backend": "PyCharm",
      "plugins": [
        "com.intellij.kubernetes"
      ]
    }
  },

  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "installOhMyZsh": true,
      "upgradePackages": true,
      "username": "automatic"
    }
  },

  "forwardPorts": [
    5555,
    5000,
    6379
  ],

  "portsAttributes": {
    "5555": {
      "label": "Flower",
      "onAutoForward": "notify"
    },
    "5000": {
      "label": "Flask",
      "onAutoForward": "notify"
    },
    "6379": {
      "label": "Redis",
      "onAutoForward": "silent"
    }
  },

  "postCreateCommand": "pip install --no-cache-dir -r requirements.txt",

  "mounts": [
    "source=${localEnv:DOWNLOAD_PATH},target=${localEnv:DOWNLOAD_PATH},type=bind"
  ]
}
